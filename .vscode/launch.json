{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "Virtual Client",
      "type": "debugpy",
      "request": "launch",
      "module": "virtual_client",
      "python": "${workspaceFolder}/virtual-client/.venv/bin/python",
      "cwd": "${workspaceFolder}/virtual-client",
      "console": "integratedTerminal",
      "justMyCode": true,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/virtual-client/src",
        "AURA_VC_REPLY_TIMEOUT": "600",
        "AURA_DSN": "postgres://aura:aura@127.0.0.1:30432/aura?sslmode=disable",
        "AURA_LLM_API_KEY": "ollama",
        "AURA_LLM_MODEL": "gemma4:e2b-mlx",
        "AURA_LLM_BASE_URL": "http://127.0.0.1:11434/v1"
      },
      "args": [
        "--channel",
        "web",
        "--scenario",
        "cancel-in-transit"
      ]
    },
    {
      "name": "svc-ai-agent: local debug",
      "type": "debugpy",
      "request": "launch",
      "module": "aura_ai",
      "python": "${workspaceFolder}/svc-ai-agent/.venv/bin/python",
      "cwd": "${workspaceFolder}/svc-ai-agent",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "svc-ai-agent: scale down pod",
      "postDebugTask": "svc-ai-agent: scale up pod",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/svc-ai-agent/src",
        "AURA_NATS_URL": "nats://127.0.0.1:30422",
        "AURA_DSN": "postgres://aura_app:aura_app@127.0.0.1:30432/aura?sslmode=disable",
        "AURA_LLM_API_KEY": "ollama",
        "AURA_LLM_MODEL": "gemma4:e2b-mlx",
        "AURA_LLM_BASE_URL": "http://127.0.0.1:11434/v1",
        "AURA_EMBEDDING_MODEL": "embeddinggemma-2:270m-mxfp8-text",
        "AURA_JS_DRAIN_DEBUGING": "1"
      }
    }
  ]
}
